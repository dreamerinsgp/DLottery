# The browser RPC must serve the same chain as the backend configuration.
VITE_RPC_URL=http://127.0.0.1:8545
# Empty uses same-origin /api and Vite/nginx proxy.
VITE_API_URL=
API_PROXY_TARGET=http://127.0.0.1:8081
# Optional: enables the faucet only for this exact mintable token on Sepolia.
VITE_TEST_TOKEN_ADDRESS=
